{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vibecomfy.local/porting/edit/v2/set-title.schema.json",
  "title": "set_title",
  "type": "object",
  "additionalProperties": false,
  "required": ["op", "target", "title"],
  "properties": {
    "op": {
      "const": "set_title"
    },
    "target": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": "string" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    }
  }
}
