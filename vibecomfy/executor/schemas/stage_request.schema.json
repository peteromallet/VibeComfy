{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecomfy.dev/schemas/executor/stage_request.schema.json",
  "title": "StageRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal",
    "priorities",
    "route",
    "interaction_mode",
    "previous_package_refs"
  ],
  "properties": {
    "goal": {"type": "string", "minLength": 1},
    "priorities": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "route": {"type": "string", "minLength": 1},
    "interaction_mode": {"type": "string", "minLength": 1},
    "previous_package_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
