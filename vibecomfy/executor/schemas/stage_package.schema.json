{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecomfy.dev/schemas/executor/stage_package.schema.json",
  "title": "StagePackage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage_id",
    "produced_at",
    "artifacts",
    "diagnostics",
    "status",
    "next_stage_hints",
    "ledger",
    "needs_input"
  ],
  "properties": {
    "stage_id": {"type": "string", "minLength": 1},
    "produced_at": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/evidence_artifact"}
    },
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "#/$defs/stage_diagnostic"}
    },
    "status": {"$ref": "#/$defs/status"},
    "next_stage_hints": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "ledger": {"$ref": "#/$defs/evidence_ledger"},
    "needs_input": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/needs_input"}
      ]
    },
    "research_attempt": {
      "enum": ["never", "empty", "thin", "grounded"]
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "ok",
        "no_results",
        "rate_limited",
        "timeout",
        "unavailable",
        "invalid_request",
        "refused"
      ]
    },
    "evidence_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "body", "metadata"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "body": {},
        "source": {"type": "string", "minLength": 1},
        "metadata": {"type": "object"}
      }
    },
    "evidence_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence_ledger_entry"}
        }
      }
    },
    "evidence_ledger_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "conclusion", "evidence_ids", "uncertainty"],
      "properties": {
        "decision": {"type": "string", "minLength": 1, "maxLength": 1000},
        "conclusion": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "uncertainty": {"type": "string", "maxLength": 2000}
        ,"claim_provenance": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "stage_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity", "evidence_ids", "details"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "severity": {"enum": ["info", "warning", "error"]},
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "details": {"type": "object"}
      }
    },
    "needs_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "question",
        "missing_information",
        "evidence_ids",
        "options"
      ],
      "properties": {
        "decision": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "missing_information": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "options": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "bounded_assumption": {"type": "string", "minLength": 1}
      }
    }
  }
}
