{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecomfy.dev/schemas/executor/needs_input.schema.json",
  "title": "NeedsInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "question",
    "missing_information",
    "evidence_ids",
    "options"
  ],
  "properties": {
    "decision": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "missing_information": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "options": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "bounded_assumption": {"type": "string", "minLength": 1}
  }
}
