DEFAULT_FPS = 16
DEFAULT_FRAMES = 33
DEFAULT_SEED = 987948718394761
GUIDE_STRENGTH = 6

READY_METADATA = ReadyMetadata.build(
    capability='unknown',
    requirements={'models': ['clip_vision_h.safetensors', 'umt5_xxl_fp8_e4m3fn_scaled.safetensors', 'uni_pc', 'wan2.1_i2v_480p_14B_fp16.safetensors', 'wan_2.1_vae.safetensors']},
    provenance={'source_path': 'workflow_corpus/official/video/wan_i2v.json', 'source_id': 'wan_i2v', 'source_type': 'api', 'source_workflow_path': 'workflow_corpus/official/video/wan_i2v.json', 'output_mode': 'ready_template', 'ready_id': 'video/wan_i2v'},
)

def build() -> VibeWorkflow:
    """Build the workflow (auto-generated)."""
    wf = new_workflow(READY_METADATA, source_path=__file__)

    unetloader = UNETLoader(unet_name='wan2.1_i2v_480p_14B_fp16.safetensors')

    cliploader = CLIPLoader(
        clip_name='umt5_xxl_fp8_e4m3fn_scaled.safetensors',
        type_='wan',
    )

    vaeloader = VAELoader(vae_name='wan_2.1_vae.safetensors')
    clipvisionloader = CLIPVisionLoader(clip_name='clip_vision_h.safetensors')

    # Inputs
    image, mask = LoadImage(image='image_to_video_wan_start_image.png')

    # Conditioning
    cliptextencode = CLIPTextEncode(
        text='a cute anime girl with massive fennec ears and a big fluffy tail wearing a maid outfit turning around',
        clip=cliploader,
    )

    cliptextencode_2 = CLIPTextEncode(
        text='色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走',
        clip=cliploader,
    )

    clipvisionencode = CLIPVisionEncode(
        crop='none',
        clip_vision=clipvisionloader,
        image=image,
    )

    modelsamplingsd3 = ModelSamplingSD3(shift=8, model=unetloader)

    positive, negative, latent = WanImageToVideo(
        height=512,
        length=DEFAULT_FRAMES,
        width=512,
        clip_vision_output=clipvisionencode,
        negative=cliptextencode_2,
        positive=cliptextencode,
        start_image=image,
        vae=vaeloader,
    )

    ksampler = KSampler(
        seed=DEFAULT_SEED,
        cfg=GUIDE_STRENGTH,
        sampler_name='uni_pc',
        latent_image=latent,
        model=modelsamplingsd3,
        negative=negative,
        positive=positive,
    )

    # Decode
    vaedecode = VAEDecode(samples=ksampler, vae=vaeloader)
    createvideo = CreateVideo(fps=DEFAULT_FPS, images=vaedecode)

    # Outputs
    savevideo = SaveVideo(video=createvideo)


    PUBLIC_INPUTS = {
        'seed': InputSpec(node=ksampler, field='seed', default=DEFAULT_SEED, type='INT'),
        'width': InputSpec(node=positive, field='width', default=512, type='INT'),
        'height': InputSpec(node=positive, field='height', default=512, type='INT'),
        'frames': InputSpec(node=positive, field='length', default=DEFAULT_FRAMES, type='INT'),
        'image': InputSpec(node=image, field='image', default='image_to_video_wan_start_image.png', type='IMAGE', required=True, aliases=('input_image',), media_semantics='image'),
        'fps': InputSpec(node=createvideo, field='fps', default=DEFAULT_FPS, type='FLOAT'),
        'prompt': InputSpec(node=cliptextencode, field='text', default='a cute anime girl with massive fennec ears and a big fluffy tail wearing a maid outfit turning around', type='STRING', required=True, media_semantics='text'),
        'negative_prompt': InputSpec(node=cliptextencode_2, field='text', default='色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走', type='STRING', aliases=('negative',), media_semantics='text'),
    }
    return wf.finalize(PUBLIC_INPUTS, output_node=savevideo, output_type='SaveVideo', name='video', artifact_kind='video', mime_type='video/mp4', expected_cardinality='one', filename_prefix='video/ComfyUI')

