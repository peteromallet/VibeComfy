DEFAULT_PROMPT_2 = '色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走'
DEFAULT_SEED = 987948718394761
GUIDE_STRENGTH = 6
UNET_NAME = 'wan2.1_i2v_480p_14B_fp16.safetensors'
VAE_NAME = 'wan_2.1_vae.safetensors'


OUTPUT_SPEC = OutputSpec(name='video', artifact_kind='video', mime_type='video/mp4', expected_cardinality='one')

READY_METADATA = ReadyMetadata.build(
    capability='unknown',
    requirements={'models': ['clip_vision_h.safetensors', 'umt5_xxl_fp8_e4m3fn_scaled.safetensors', 'uni_pc', 'wan2.1_i2v_480p_14B_fp16.safetensors', 'wan_2.1_vae.safetensors']},
    provenance={'source_path': 'workflow_corpus/official/video/wan_i2v.json', 'source_id': 'wan_i2v', 'source_type': 'api', 'source_workflow_path': 'workflow_corpus/official/video/wan_i2v.json', 'output_mode': 'ready_template', 'ready_id': 'video/wan_i2v'},
)

def build() -> VibeWorkflow:
    """Build the workflow (auto-generated)."""
    with new_workflow(READY_METADATA, source_path=__file__) as wf:

        unetloader = UNETLoader(unet_name=UNET_NAME)
        cliploader = CLIPLoader(clip_name=CLIP_NAME, type_='wan')
        vaeloader = VAELoader(vae_name=VAE_NAME)
        clipvisionloader = CLIPVisionLoader(clip_name=CLIP_NAME_2)

        # Inputs
        image, mask = LoadImage(
            image=public('image', default='image_to_video_wan_start_image.png', type='IMAGE', required=True, aliases=('input_image',), media_semantics='image'),
            unused_widget_1='image',
        )

        # Conditioning
        cliptextencode = CLIPTextEncode(
            text=public('prompt', default=DEFAULT_PROMPT, type='STRING', required=True, media_semantics='text'),
            clip=cliploader,
        )

        cliptextencode_2 = CLIPTextEncode(
            text=public('negative_prompt', default=DEFAULT_PROMPT_2, type='STRING', aliases=('negative',), media_semantics='text'),
            clip=cliploader,
        )

        clipvisionencode = CLIPVisionEncode(
            crop='none',
            clip_vision=clipvisionloader,
            image=image,
        )

        modelsamplingsd3 = ModelSamplingSD3(shift=8, model=unetloader)

        positive, negative, latent = WanImageToVideo(
            height=public('height', default=512, type='INT'),
            length=public('frames', default=DEFAULT_FRAMES, type='INT'),
            width=public('width', default=512, type='INT'),
            clip_vision_output=clipvisionencode,
            negative=cliptextencode_2,
            positive=cliptextencode,
            start_image=image,
            vae=vaeloader,
        )

        ksampler = KSampler(
            seed=public('seed', default=DEFAULT_SEED, type='INT'),
            cfg=GUIDE_STRENGTH,
            sampler_name='uni_pc',
            unused_widget_1='randomize',
            latent_image=latent,
            model=modelsamplingsd3,
            negative=negative,
            positive=positive,
        )

        # Decode
        vaedecode = VAEDecode(samples=ksampler, vae=vaeloader)

        createvideo = CreateVideo(
            fps=public('fps', default=DEFAULT_FPS, type='FLOAT'),
            images=vaedecode,
        )

        # Outputs
        savevideo = SaveVideo(video=createvideo)

        return wf.finalize({}, filename_prefix='video/ComfyUI', spec=OUTPUT_SPEC)

